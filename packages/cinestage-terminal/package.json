{
  "name": "@cinestage/terminal",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone CineStage Terminal/Desktop local AI agent core for project memory, Graphify, Obsidian, build/debug workflows, and safe command execution.",
  "type": "module",
  "bin": {
    "cinestage": "./bin/cinestage.js"
  },
  "scripts": {
    "status": "node bin/cinestage.js status",
    "projects": "node bin/cinestage.js projects",
    "ask": "node bin/cinestage.js ask",
    "doctor": "node bin/cinestage.js doctor",
    "voice:clap": "python3 voice/cinestage_voice_trigger.py",
    "install-local": "bash install-local.sh"
  }
}
