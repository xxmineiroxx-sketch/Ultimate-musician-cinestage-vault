{
  "name": "ultimate-playback",
  "version": "0.1.0",
  "description": "Ultimate Playback - Musician's workspace for creating song presets with device setups",
  "main": "index.js",
  "scripts": {
    "postinstall": "node scripts/fix-ios-build-paths.js",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "testflight:status": "node scripts/sync-testflight-groups.js --check --warning-days 21",
    "testflight:share-latest": "node scripts/sync-testflight-groups.js --warning-days 21",
    "testflight:beta-lane": "node scripts/sync-testflight-groups.js --warning-days 21 --notify --text",
    "testflight:install-monitor": "node scripts/install-testflight-beta-lane.js --hour 9 --minute 0 --warning-days 21",
    "check:release-urls": "node scripts/check-release-urls.mjs",
    "smoke:worker": "node scripts/smoke-worker-sync.mjs",
    "check:spine": "npm run check:release-urls && npm run smoke:worker",
    "knowledge:update": "node scripts/cinestage-knowledge-refresh.mjs",
    "knowledge:update:note-only": "node scripts/cinestage-knowledge-refresh.mjs --skip-graph",
    "knowledge:projects": "node scripts/cinestage-project-index.mjs",
    "cinestage": "node packages/cinestage-terminal/bin/cinestage.js",
    "cinestage:status": "node packages/cinestage-terminal/bin/cinestage.js status",
    "cinestage:doctor": "node packages/cinestage-terminal/bin/cinestage.js doctor",
    "cinestage:projects": "node packages/cinestage-terminal/bin/cinestage.js projects",
    "cinestage:ask": "node packages/cinestage-terminal/bin/cinestage.js ask",
    "cinestage:voice": "node packages/cinestage-terminal/bin/cinestage.js voice",
    "cinestage:voice:clap": "python3 packages/cinestage-terminal/voice/cinestage_voice_trigger.py",
    "cinestage:install-local": "bash packages/cinestage-terminal/install-local.sh"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/stack": "^6.3.20",
    "expo": "~54.0.36",
    "expo-asset": "~12.0.13",
    "expo-av": "~16.0.8",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-notifications": "~0.32.17",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.19",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2"
  },
  "private": true
}
